<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/Register"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="48sp"
            android:textStyle="bold"
            android:textColor="#00fecf"
            android:gravity="center"
            android:id="@+id/registerText"
            android:layout_width="196dp"
            android:layout_height="74dp"
            android:layout_marginTop="64dp"
            android:text="Register"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.497"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.cardview.widget.CardView
            android:layout_width="348dp"
            android:layout_height="386dp"
            android:layout_marginTop="156dp"
            android:layout_marginStart="28dp"
            app:cardBackgroundColor="#323232"
            app:cardCornerRadius="16dp"
            app:cardElevation="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <EditText
                    android:textColorHint="#49484a"
                    android:gravity="center"
                    android:id="@+id/usernamer"
                    android:background="@null"
                    android:layout_width="244dp"
                    android:layout_height="53dp"
                    android:hint="UserName"
                    android:ems="10"
                    android:shadowRadius="16"
                    android:inputType="text"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.519"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.261"/>
                <EditText
                    android:textColorHint="#49484a"
                    android:gravity="center"
                    android:id="@+id/passwordr"
                    android:background="@null"
                    android:layout_width="243dp"
                    android:layout_height="49dp"
                    android:hint="PassWord"
                    android:ems="10"
                    android:shadowColor="#444444"
                    android:shadowRadius="16"
                    android:inputType="textPassword"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.515"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.455"/>
                <Button
                    android:textColor="#050505"
                    android:id="@+id/register"
                    android:layout_width="260dp"
                    android:layout_height="49dp"
                    android:layout_marginTop="276dp"
                    android:text="Register"
                    app:cornerRadius="10dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.613"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <Button
                    android:id="@+id/toLogin"
                    android:background="@null"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="320dp"
                    android:text="Sign in for here"
                    android:backgroundTint="#323232"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.921"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/Profile"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.cardview.widget.CardView
            android:layout_width="332dp"
            android:layout_height="271dp"
            android:layout_marginTop="32dp"
            android:layout_marginStart="36dp"
            app:cardBackgroundColor="#323232"
            app:cardCornerRadius="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="25sp"
                    android:textColor="#00fecf"
                    android:gravity="center_vertical"
                    android:id="@+id/emailDisplay"
                    android:layout_width="192dp"
                    android:layout_height="51dp"
                    android:layout_marginTop="64dp"
                    android:text="TextView"
                    android:layout_marginStart="116dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="78dp"
                    android:layout_height="84dp"
                    android:layout_marginTop="24dp"
                    android:src="@mipmap/ic_launcher_round"
                    android:layout_marginStart="24dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="25sp"
                    android:textColor="#00fecf"
                    android:gravity="center_vertical"
                    android:id="@+id/userNameDisplay"
                    android:layout_width="192dp"
                    android:layout_height="51dp"
                    android:layout_marginTop="16dp"
                    android:text="TextView"
                    android:layout_marginStart="116dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_width="332dp"
            android:layout_height="278dp"
            app:cardBackgroundColor="#323232"
            app:cardCornerRadius="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.493"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.715">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <Button
                    android:textColor="#050505"
                    android:id="@+id/ExitLogin"
                    android:layout_width="212dp"
                    android:layout_height="59dp"
                    android:text="LogOut"
                    android:layout_marginEnd="52dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.618"/>
                <Button
                    android:textColor="#050505"
                    android:id="@+id/Settings"
                    android:layout_width="212dp"
                    android:layout_height="59dp"
                    android:text="Setting"
                    android:layout_marginEnd="52dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.211"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/Login"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_anchor="@+id/Register"
        app:layout_anchorGravity="center">
        <TextView
            android:textSize="48sp"
            android:textStyle="bold"
            android:textColor="#00fecf"
            android:gravity="center"
            android:id="@+id/textView2"
            android:layout_width="172dp"
            android:layout_height="70dp"
            android:layout_marginTop="64dp"
            android:text="Login"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.497"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.cardview.widget.CardView
            android:layout_width="348dp"
            android:layout_height="386dp"
            android:layout_marginTop="156dp"
            android:layout_marginStart="28dp"
            app:cardBackgroundColor="#323232"
            app:cardCornerRadius="16dp"
            app:cardElevation="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <EditText
                    android:textColorHint="#49484a"
                    android:gravity="center"
                    android:id="@+id/username"
                    android:background="@null"
                    android:layout_width="244dp"
                    android:layout_height="53dp"
                    android:hint="UserName"
                    android:ems="10"
                    android:shadowRadius="16"
                    android:inputType="text"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.519"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.261"/>
                <EditText
                    android:textColorHint="#49484a"
                    android:gravity="center"
                    android:id="@+id/password"
                    android:background="@null"
                    android:layout_width="243dp"
                    android:layout_height="49dp"
                    android:hint="PassWord"
                    android:ems="10"
                    android:shadowColor="#444444"
                    android:shadowRadius="16"
                    android:inputType="textPassword"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.515"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.455"/>
                <Button
                    android:textColor="#050505"
                    android:id="@+id/login"
                    android:layout_width="260dp"
                    android:layout_height="49dp"
                    android:layout_marginTop="272dp"
                    android:text="Login"
                    app:cornerRadius="10dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.613"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <Button
                    android:id="@+id/toRegister"
                    android:background="@null"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sign up for here"
                    android:layout_marginEnd="16dp"
                    android:backgroundTint="#323232"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/login"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
